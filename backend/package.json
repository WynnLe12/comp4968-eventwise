{
  "name": "eventwise-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "db:up": "docker compose -f ../docker-compose.yml up -d --wait",
    "db:seed": "node ../scripts/db-seed.mjs",
    "db:reset": "docker compose -f ../docker-compose.yml down -v && npm run db:up && npm run db:seed"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "aws-jwt-verify": "^5.2.1",
    "mysql": "^2.18.1",
    "mysql2": "^3.24.6"
  }
}
