{
  "name": "eventwise-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run build && cd dist && node --test",
    "db:up": "docker compose -f ../docker-compose.yml up -d --wait",
    "db:seed": "node ../scripts/db-seed.mjs",
    "db:reset": "docker compose -f ../docker-compose.yml down -v && npm run db:up && npm run db:seed",
    "test:vendors:db": "npm run build && node dist/verification/vendors-mysql.js",
    "db:check": "tsx shared/db/check.ts",
    "test:db": "npm run build && node dist/verification/expenses-mysql.js",
    "test:payments:db": "npm run build && node dist/verification/payments-mysql.js",
    "test:summary:db": "npm run build && node dist/verification/summary-mysql.js",
    "ddb:up": "docker compose -f ../docker-compose.dynamodb.yml up -d",
    "ddb:down": "docker compose -f ../docker-compose.dynamodb.yml down",
    "ddb:reset": "docker compose -f ../docker-compose.dynamodb.yml down -v",
    "ddb:create-table": "tsx guest-service/scripts/createLocalTable.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1168.0",
    "@aws-sdk/lib-dynamodb": "^3.1168.0",
    "aws-jwt-verify": "^5.2.1",
    "dotenv": "^18.0.10",
    "mysql": "^2.18.1",
    "mysql2": "^3.24.6"
  }
}
