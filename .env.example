# Local development only; never commit real credentials.
# Copy to repository-root .env. Backend loads it without overriding shell variables.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=eventwise
DB_PASSWORD=localpass
DB_NAME=eventwise
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=10000

# For TLS-enabled RDS: absolute path to the trusted CA bundle.
# Set DB_HOST/DB_PORT/credentials for the target environment as well.
# DB_SSL_CA_FILE=/absolute/path/to/rds-ca-bundle.pem

HOST=127.0.0.1
PORT=3000

# Local protected API: use the security team's actual Cognito pool and app client.
# Leave unset until available. Missing config never enables an authentication bypass.
# COGNITO_USER_POOL_ID=us-west-2_REPLACE_WITH_POOL_ID
# COGNITO_CLIENT_ID=REPLACE_WITH_APP_CLIENT_ID

# Events Lambda invitation links and optional email publishing.
# EVENTS_ORGANIZER_ORIGIN=https://organizer.example
# Local development can use EVENTS_ORGANIZER_ORIGIN=http://localhost:5173
# EVENTS_INVITATION_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/ACCOUNT_ID/eventwise-invitation-emails
# Provision EVENTS_INVITATION_EMAIL_KEY separately as a secret containing a base64-encoded 32-byte key.

# DynamoDB guests table (Feature 7). See database/dynamodb/guests.md.
GUESTS_TABLE_NAME=EventWise_Guests
# DynamoDB timeline table (Feature 13). See database/dynamodb/timeline.md.
TIMELINE_TABLE_NAME=EventWise_Timeline
# Local DynamoDB (npm run ddb:up && npm run ddb:create-table && npm run ddb:create-timeline-table from backend/).
# Leave unset to use the real AWS table with your own AWS credentials.
# DYNAMODB_ENDPOINT=http://127.0.0.1:8000
