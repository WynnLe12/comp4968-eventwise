# Local development only; never commit real credentials.
# Copy to repository-root .env. Backend loads it without overriding shell variables.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=eventwise
DB_PASSWORD=localpass
DB_NAME=eventwise
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=10000

# For TLS-enabled RDS: absolute path to the trusted CA bundle.
# Set DB_HOST/DB_PORT/credentials for the target environment as well.
# DB_SSL_CA_FILE=/absolute/path/to/rds-ca-bundle.pem

HOST=127.0.0.1
PORT=3000

# Local protected API: use the security team's actual Cognito pool and app client.
# Leave unset until available. Missing config never enables an authentication bypass.
# COGNITO_USER_POOL_ID=us-west-2_REPLACE_WITH_POOL_ID
# COGNITO_CLIENT_ID=REPLACE_WITH_APP_CLIENT_ID

# DynamoDB guests table (Feature 7). See database/dynamodb/guests.md.
GUESTS_TABLE_NAME=EventWise_Guests
# Optional: point at DynamoDB Local instead of AWS, e.g. http://127.0.0.1:8000
# DYNAMODB_ENDPOINT=
