# Example configuration only - never commit real secrets.

# Local MySQL (docker compose up -d). Copy this file to .env for local runs.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=eventwise
DB_PASSWORD=localpass
DB_NAME=eventwise

# DynamoDB guests table (Feature 7). See database/dynamodb/guests.md.
GUESTS_TABLE_NAME=EventWise_Guests
# Optional: point at DynamoDB Local instead of AWS, e.g. http://127.0.0.1:8000
# DYNAMODB_ENDPOINT=
